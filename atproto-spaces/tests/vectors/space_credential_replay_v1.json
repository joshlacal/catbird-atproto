{
  "version": 1,
  "description": "Ordered presentations, already signature- and token-verified, offered to one replay store keyed on (credential issuer, nonce). Each step's created/expires/nonce passed the freshness checks at now_sec.",
  "max_signature_age_secs": 300,
  "max_clock_skew_secs": 30,
  "steps": [
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000000,
      "expect": "accept",
      "note": "first use"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000001,
      "expect": "reject",
      "note": "same issuer and nonce inside the window"
    },
    {
      "issuer": "did:web:authority-b.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000001,
      "expect": "accept",
      "note": "same nonce under another issuer"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-2",
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000002,
      "expect": "accept",
      "note": "new nonce"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": null,
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000002,
      "expect": "accept",
      "note": "no nonce: untracked"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": null,
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000003,
      "expect": "accept",
      "note": "no nonce again: still untracked"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "now_sec": 1800000300,
      "expect": "reject",
      "note": "last second the created window accepts"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "now_sec": 1800000010,
      "expect": "accept",
      "note": "no created: window measured from first sight"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "now_sec": 1800000339,
      "expect": "reject",
      "note": "no created: still inside now + 330"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "now_sec": 1800000340,
      "expect": "accept",
      "note": "no created: window over, the store has forgotten it"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-4",
      "created": 1800000400,
      "expires": 1800000410,
      "now_sec": 1800000400,
      "expect": "accept",
      "note": "expires bounds the window"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-4",
      "created": 1800000400,
      "expires": 1800000410,
      "now_sec": 1800000440,
      "expect": "reject",
      "note": "last second expires (+30 s skew) accepts"
    }
  ]
}
